<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-md-8 offset-md-2">
        <br>
        <h3>Create a New Listing</h3>
        <form method="POST" action="/listings" novalidate class="needs-validation">
            <div class="mb-3">
                <lable for = "title" class="form-lable">Title</lable>
                <input name="listing[title]" placeholder="add a catchy title" type="text" class="form-control" required>
                <div class="valid-feedback">Title Looks Good!</div>
            </div>
            <div class="mb-3">
                <lable for = "description" class="form-lable">Description</lable>
                <textarea name="listing[description]" placeholder="enter description" type="text" class="form-control" required ></textarea>
                <div class="invalid-feedback">Please enter the short discription</div>
            </div>
            <div class="row">
                <div class="mb-3 col-4">
                    <lable for = "image_url" class="form-lable">Image URL</lable>
                    <input name="listing[image][url]" placeholder="enter img URL/Link" type="text" class="form-control" >
                </div>
                <div class="mb-3 col-8">
                    <lable for = "price" class="form-lable">Price</lable>
                    <input name="listing[price]" placeholder="1200"  step="0.01" class="form-control" required>
                    <div class="invalid-feedback">Please Enter the Valid Price</div>
                </div>
            </div>
            <div class="mb-3">
                <lable for = "country" class="form-lable">Country</lable>
                <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
                <div class="invalid-feedback">Please Enter the Country Name</div>
            </div>
            <div class="mb-3">
                <lable for = "location" class="form-lable">Location</lable>
                <input name="listing[location]" placeholder="Washim, Maharashtra" type="text" class="form-control" required>
                <div class="invalid-feedback">Location Should be Valid</div>
            </div>
            <br>
            <button class="btn btn-dark add-btn">Add</button>
            <br> <br> <br>
        </form>
    </div>
</div>